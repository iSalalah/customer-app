# =============================================================================
# Dhofar Municipality Citizen Portal - example environment
# Copy to .env and replace EVERY placeholder. Never commit a real .env.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# =============================================================================

# --- Runtime ----------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
LOG_LEVEL=debug
# Number of reverse proxies in front of the API (0 = direct exposure).
TRUST_PROXY=1
TZ=UTC

# --- Database ---------------------------------------------------------------
# timezone=UTC is required: all DateTime values are stored and compared in UTC.
DATABASE_URL="mysql://dhofar:CHANGE_ME_DB_PASSWORD@localhost:3306/dhofar_portal?connection_limit=10&timezone=UTC"
# Only used by `prisma migrate dev` when authoring a migration.
SHADOW_DATABASE_URL="mysql://dhofar:CHANGE_ME_DB_PASSWORD@localhost:3306/dhofar_portal_shadow"
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=dhofar_portal
MYSQL_USER=dhofar
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD

# --- Redis ------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
REDIS_KEY_PREFIX=dhofar:

# --- Secrets (32+ bytes each, all distinct) ---------------------------------
# HMAC pepper for OTP hashes. Rotating it invalidates all in-flight OTPs.
OTP_PEPPER=CHANGE_ME_otp_pepper_at_least_32_characters_long
# HMAC pepper for civil-ID lookup hashes.
CIVIL_ID_PEPPER=CHANGE_ME_civil_id_pepper_at_least_32_characters
# base64url of exactly 32 random bytes - AES-256-GCM key for civil-ID at rest.
CIVIL_ID_ENC_KEY=CHANGE_ME_base64url_encoded_32_byte_key_here_ok
# Signs session cookies and derives the CSRF token.
SESSION_SECRET=CHANGE_ME_session_secret_at_least_32_characters
COOKIE_DOMAIN=
# Set true behind TLS. Forced true when NODE_ENV=production.
COOKIE_SECURE=false

# --- Sessions ---------------------------------------------------------------
CITIZEN_IDLE_TIMEOUT_SECONDS=120
CITIZEN_ABSOLUTE_TIMEOUT_SECONDS=1800
CITIZEN_IDLE_WARNING_SECONDS=30
STAFF_ACCESS_TTL_SECONDS=900
STAFF_REFRESH_TTL_SECONDS=28800

# --- OTP --------------------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_PHONE_PER_HOUR=3
OTP_MAX_PER_IP_PER_HOUR=10

# --- Staff login throttling -------------------------------------------------
STAFF_MAX_FAILED_LOGINS=5
STAFF_LOCKOUT_SECONDS=900

# --- Rate limits ------------------------------------------------------------
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=900
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_TRACKING_MAX=10
RATE_LIMIT_TRACKING_WINDOW_SECONDS=300
RATE_LIMIT_UPLOAD_MAX=20
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=3600

# --- CORS -------------------------------------------------------------------
# Comma-separated exact origins. No wildcards are accepted.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Public URLs ------------------------------------------------------------
PUBLIC_KIOSK_URL=http://localhost:5173
PUBLIC_ADMIN_URL=http://localhost:5174
PUBLIC_TRACKING_BASE_URL=http://localhost:5173/track

# --- Storage ----------------------------------------------------------------
# local | s3
STORAGE_DRIVER=local
# Must sit OUTSIDE any web root.
STORAGE_LOCAL_ROOT=./var/uploads
S3_ENDPOINT=
S3_REGION=me-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- Uploads ----------------------------------------------------------------
MAX_UPLOAD_BYTES=10485760
MAX_ATTACHMENTS_PER_REQUEST=5

# --- Malware scanning -------------------------------------------------------
MALWARE_SCAN_ENABLED=false
# noop | clamav
MALWARE_SCANNER_DRIVER=noop
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# --- SMS --------------------------------------------------------------------
# mock | http
SMS_DRIVER=mock
SMS_SENDER_ID=DhofarMun
SMS_HTTP_ENDPOINT=
SMS_HTTP_API_KEY=
SMS_HTTP_TIMEOUT_MS=5000

# --- Documentation ----------------------------------------------------------
SWAGGER_ENABLED=true

# --- Frontend (Vite) --------------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_DEFAULT_LOCALE=ar
VITE_IDLE_TIMEOUT_SECONDS=120
VITE_IDLE_WARNING_SECONDS=30
VITE_KIOSK_ID=KIOSK-DEV-01
